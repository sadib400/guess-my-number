{
  "name": "guess-my-number",
  "version": "1.0.0",
  "description": "Guess My Number - Couples & friends guessing game",
  "scripts": {
    "prepare-web": "node -e \"const fs=require('fs'); if(!fs.existsSync('www'))fs.mkdirSync('www'); fs.copyFileSync('GuessMyNumber.html','www/index.html'); console.log('Web files ready.');\"",
    "sync": "npm run prepare-web && npx cap sync android",
    "open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
